w_count":null,"_view_module":"@jupyter-widgets/base","_view_module_version":"1.2.0","_view_name":"StyleView","description_width":""}}}}}},"cells":[{"cell_type":"code","source":["!pip install -q -U transformers datasets accelerate scikit-learn"],"metadata":{"id":"3b3I1-_RIQIf","executionInfo":{"status":"ok","timestamp":1793385928301,"user_tz":-330,"elapsed":31810,"user":{"displayName":"Ankit Maurya","userId":"03038703394380253155"}}},"execution_count":7,"outputs":[]},{"cell_type":"code","source":["import numpy as np\n","import pandas as pd\n","import torch\n","from datasets import Dataset, load_dataset\n","from sklearn.metrics import accuracy_score, f1_score\n","from transformers import (\n","    AutoTokenizer,\n","    AutoModelForSequenceClassification,\n","    DataCollatorWithPadding,\n","    TrainingArguments,\n","    Trainer,\n",")\n","\n","MODEL_NAME = \"distilbert-base-uncased\"\n","use_gpu = torch.cuda.is_available()\n","print(\"GPU available:\", use_gpu)\n","\n","N_TRAIN = 3000 if use_gpu else 800\n","N_TEST = 1000 if use_gpu else 300\n","MAX_LEN = 128\n","\n","# ---- 1. Data: try 3 sources in order ----\n","def get_data():\n","    # Source A: official dataset id\n","    try:\n","        ds = load_dataset(\"stanfordnlp/imdb\")\n","        print(\"Loaded from stanfordnlp/imdb\")\n","        return ds[\"train\"].to_pandas(), ds[\"test\"].to_pandas()\n","    except Exception as e:\n","        print(\"Source A failed:\", repr(e)[:150])\n","    # Source B: direct parquet\n","    try:\n","        base = \"https://huggingface.co/datasets/stanfordnlp/imdb/resolve/main/plain_text/\"\n","        tr = pd.read_parquet(base + \"train-00000-of-00001.parquet\")\n","        te = pd.read_parquet(base + \"test-00000-of-00001.parquet\")\n","        print(\"Loaded from parquet URL\")\n","        return tr, te\n","    except Exception as e:\n","        print(\"Source B failed:\", repr(e)[:150])\n","    # Source C: tiny built-in dataset so the pipeline still runs\n","    print(\"Using tiny built-in dataset (demo only)\")\n","    pos = [\"I loved this movie, it was fantastic\", \"Great acting and a wonderful story\",\n","           \"Absolutely brilliant, highly recommended\", \"A beautiful and moving film\",\n","           \"Superb direction, I enjoyed every minute\"] * 40\n","    neg = [\"Terrible plot and awful acting\", \"I hated this movie, a total waste of time\",\n","           \"Boring, slow and badly written\", \"Worst film I have seen this year\",\n","           \"Disappointing and painfully dull\"] * 40\n","    df = pd.DataFrame({\"text\": pos + neg, \"label\": [1]*len(pos) + [0]*len(neg)})\n","    df = df.sample(frac=1, random_state=42).reset_index(drop=True)\n","    return df.iloc[:300], df.iloc[300:]\n","\n","train_df, test_df = get_data()\n","train_df = train_df.sample(min(N_TRAIN, len(train_df)), random_state=42).reset_index(drop=True)\n","test_df = test_df.sample(min(N_TEST, len(test_df)), random_state=42).reset_index(drop=True)\n","\n","train_ds = Dataset.from_pandas(train_df[[\"text\", \"label\"]])\n","test_ds = Dataset.from_pandas(test_df[[\"text\", \"label\"]])\n","\n","# ---- 2. Tokenize ----\n","tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME)\n","\n","def tokenize(batch):\n","    return tokenizer(batch[\"text\"], truncation=True, max_length=MAX_LEN)\n","\n","train_ds = train_ds.map(tokenize, batched=True, remove_columns=[\"text\"])\n","test_ds = test_ds.map(tokenize, batched=True, remove_columns=[\"text\"])\n","collator = DataCollatorWithPadding(tokenizer=tokenizer)\n","\n","# ---- 3. Model ----\n","model = AutoModelForSequenceClassification.from_pretrained(\n","    MODEL_NAME, num_labels=2,\n","    id2label={0: \"NEGATIVE\", 1: \"POSITIVE\"},\n","    label2id={\"NEGATIVE\": 0, \"POSITIVE\": 1},\n",")\n","\n","# ---- 4. Metrics ----\n","def compute_metrics(p):\n","    preds = np.argmax(p.predictions, axis=-1)\n","    return {\n","        \"accuracy\": accuracy_score(p.label_ids, preds),\n","        \"f1\": f1_score(p.label_ids, preds, average=\"weighted\"),\n","    }\n","\n","# ---- 5. Train (only basic, stable arguments) ----\n","args = TrainingArguments(\n","    output_dir=\"out\",\n","    learning_rate=3e-5,\n","    per_device_train_batch_size=32,\n","    per_device_eval_batch_size=64,\n","    num_train_epochs=1,\n","    save_strategy=\"no\",\n","    logging_steps=20,\n","    fp16=use_gpu,\n","    report_to=\"none\",\n",")\n","\n","trainer = Trainer(\n","    model=model,\n","    args=args,\n","    train_dataset=train_ds,\n","    eval_dataset=test_ds,\n","    data_collator=collator,\n","    compute_metrics=compute_metrics,\n",")\n","\n","trainer.train()\n","print(trainer.evaluate())\n","\n","# ---- 6. Inference (no pipeline, avoids version issues) ----\n","def predict(text):\n","    model.eval()\n","    enc = tokenizer(text, return_tensors=\"pt\", truncation=True, max_length=MAX_LEN).to(model.device)\n","    with torch.no_grad():\n","        probs = torch.softmax(model(**enc).logits, dim=-1)[0]\n","    i = int(probs.argmax())\n","    return model.config.id2label[i], round(float(probs[i]), 4)\n","\n","print(predict(\"This movie was absolutely fantastic!\"))\n","print(predict(\"Terrible plot and awful acting.\"))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000,"referenced_widgets":["534b457a27a049ea886dc0e9eb35ae81","da3da854996d4576a0c6788a2690cb8c","4667f18194964562b698cbe6b9b18af3","99ad6aefd40f41b899f77f9aaa802049","ab562824fecc408aa146c29ac8b01b9a","f43a0eaf569844648eace3ffe7da85b2","550379c6d5184205bcb3c12ac98eee95","8debf93e0b1847749988aff1c30eeb31","331288d5985e4f4b93d40dd2935dc58d","98e01e0fe18a45ae993a1354d118b765","05e7b0b5943c446da75bb36ea95efd1a","ad868351231f42faa3ee57b3fe2e2daf","cb42ea27980942cbb9804be3d13c94a2","13c281e0f49040abb3b63ff7e9ee31db","a523d021ae97440e8e3d5b2df9777235","90252c56452d458598d1756d556d4f33","89ede76f7b0d4063a764b243f5c2baa8","dbdefe2cf2764d0893cc1a6de1fd6d8b","57b97e1e00a247abaa64efd394ee9342","5e433f55801845