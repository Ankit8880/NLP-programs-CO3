utionInfo":{"status":"ok","timestamp":1793167365009,"user_tz":-330,"elapsed":512,"user":{"displayName":"Ankit Maurya","userId":"03038703394380253155"}},"outputId":"e1e37bea-962c-4609-f31f-5f3ee0e82d93"},"source":["def get_bert_embeddings(sentences, model, tokenizer, pooling='mean'):\n","    model.eval()\n","    embeddings = []\n","\n","    for sentence in sentences:\n","        # Tokenize and prepare input\n","        inputs = tokenizer(sentence, return_tensors='pt', padding=True, truncation=True, max_length=128).to(device)\n","\n","        with torch.no_grad():\n","            outputs = model(**inputs)\n","\n","        # Get the last hidden state: shape [batch_size, sequence_length, hidden_size]\n","        last_hidden_state = outputs.last_hidden_state\n","\n","        if pooling == 'cls':\n","            # [CLS] token is at index 0\n","            embedding = last_hidden_state[0, 0, :].cpu().numpy()\n","        elif pooling == 'mean':\n","            # Average along the sequence length dimension\n","            embedding = torch.mean(last_hidden_state, dim=1).squeeze().cpu().numpy()\n","\n","        embeddings.append(embedding)\n","\n","    return np.array(embeddings)\n","\n","bert_embeds = get_bert_embeddings(sentences, bert_model, bert_tokenizer, pooling='mean')\n","print(\"BERT Mean-Pooled Embeddings Shape:\", bert_embeds.shape)"],"execution_count":3,"outputs":[{"output_type":"stream","name":"stdout","text":["BERT Mean-Pooled Embeddings Shape: (3, 768)\n"]}]},{"cell_type":"markdown","metadata":{"id":"4d357c4a"},"source":["### 2. GPT-2 Embeddings\n","GPT-2 is an autoregressive (causal) decoder model. Unlike BERT, it doesn't have a special `[CLS]` token. A common approach is to take the mean of all token hidden states or target the last token's representation."]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"9be1ab5f","executionInfo":{"status":"ok","timestamp":1793167366044,"user_tz":-330,"elapsed":423,"user":{"displayName":"Ankit Maurya","userId":"03038703394380253155"}},"outputId":"fbcff6c1-a704-4b14-e1c7-57f58ce94e92"},"source":["def get_gpt2_embeddings(sentences, model, tokenizer, pooling='mean'):\n","    model.eval()\n","    embeddings = []\n","\n","    for sentence in sentences:\n","        inputs = tokenizer(sentence, return_tensors='pt', padding=True, truncation=True, max_length=128).to(device)\n","\n","        with torch.no_grad():\n","            outputs = model(**inputs)\n","\n","        last_hidden_state = outputs.last_hidden_state\n","\n","        if pooling == 'last':\n","            # Extract the vector corresponding to the last token in the sequence\n","            embedding = last_hidden_state[0, -1, :].cpu().numpy()\n","        elif pooling == 'mean':\n","            # Mean pool across sequence tokens\n","            embedding = torch.mean(last_hidden_state, dim=1).squeeze().cpu().numpy()\n","\n","        embeddings.append(embedding)\n","\n","    return np.array(embeddings)\n","\n","gpt2_embeds = get_gpt2_embeddings(sentences, gpt2_model, gpt2_tokenizer, pooling='mean')\n","print(\"GPT-2 Mean-Pooled Embeddings Shape:\", gpt2_embeds.shape)"],"execution_count":4,"outputs":[{"output_type":"stream","name":"stdout","text":["GPT-2 Mean-Pooled Embeddings Shape: (3, 768)\n"]}]}]}